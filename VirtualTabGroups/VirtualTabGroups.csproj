  <!-- DllExport IL post-processing only runs under full-framework MSBuild (msbuild.exe).
       The AppDomain-isolated task cannot be loaded by .NET SDK's MSBuild (dotnet build),
       so we skip the import entirely during SDK builds (e.g. dotnet test). Exports are
       only needed in the final x64/x86/ARM64 plugin DLL, never in test builds. -->
  <Import Project="..\packages\DllExport.1.7.4\tools\net.r_eg.DllExport.targets"
          Condition="Exists('..\packages\DllExport.1.7.4\tools\net.r_eg.DllExport.targets') And '$(MSBuildRuntimeType)' == 'Full'" />
