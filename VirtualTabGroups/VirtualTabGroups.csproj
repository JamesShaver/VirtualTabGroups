  <!-- 3F.DllExport configuration.
       DllExportMetaLibFullPath: tells the IL post-processor where to find the attribute DLL
       so it can locate [DllExportAttribute] by scanning the compiled assembly's custom attributes.
       DllExportAttributeFullName: the fully-qualified attribute name to match. We use the
       RGiesecke backwards-compat name so that 'using RGiesecke.DllExport; [DllExport(...)]'
       compiles and is recognised by the post-processor.
       DllExportOurILAsm: use the CoreCLR ilasm/ildasm bundled in the package (no VS SDK needed).
  -->
  <PropertyGroup>
    <!-- 3F.DllExport settings. DllExportNamespace + DllExportMetaLibAttr compose the
         fully-qualified attribute name: RGiesecke.DllExport.DllExportAttribute.
         This matches the attribute defined in RGiesecke.DllExport.Metadata.dll (1.2.7)
         and used via 'using RGiesecke.DllExport; [DllExport(...)]' in source.
         DllExportOurILAsm=true uses the CoreCLR ilasm/ildasm bundled in the package
         so no Visual Studio C++ workload or SDK path is needed at build time. -->
    <DllExportMetaLibFullPath>..\packages\UnmanagedExports.1.2.7\lib\net\RGiesecke.DllExport.Metadata.dll</DllExportMetaLibFullPath>
    <DllExportNamespace>RGiesecke.DllExport</DllExportNamespace>
    <DllExportMetaLibAttr>DllExportAttribute</DllExportMetaLibAttr>
    <DllExportOurILAsm>true</DllExportOurILAsm>
  </PropertyGroup>
